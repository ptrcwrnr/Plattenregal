    "Sprache" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language"
          }
        }
      }
    },
    "Sprache der App" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App language"
          }
        }
      }
    },
    "Sprache, Darstellung, Startseite, Export und alle anderen Einstellungen gehen auf ihren Standard zurück. Sammlung, Regale, Standorte, der Discogs-Token sowie Speicherort und Aufbewahrung der Sicherungen bleiben." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language, appearance, start page, export and all other settings return to their defaults. Collection, shelves, locations, the Discogs token and the backup folder and retention are kept."
          }
        }
      }
    },
    "Stand %@" : {
      "localizations" : {

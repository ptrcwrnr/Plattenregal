            "value" : "Release #%@"
          }
        }
      }
    },
    "Release-Daten werden bei jeder Synchronisierung aktualisiert; die Tracklisten folgen danach im Hintergrund. Ohne Verbindung bleiben Sammlung und Standorte vollständig verfügbar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Release data is updated with every sync; the tracklists follow in the background. Without a connection, your collection and its locations remain fully available."
          }
        }
      }
    },

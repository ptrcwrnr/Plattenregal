          }
        }
      }
    },
    "Plattenregal %@ %@%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Plattenregal %1$@ %2$@%3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plattenregal %@ %@%@"
          }
        }
